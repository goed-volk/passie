# PostHog analytics key:
# - For local development, set the passie-dev key in .env.local
# - For production deploy, pass the passie-prod key in the deploy shell/CI environment
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog host URL (defaults to https://eu.i.posthog.com via same-origin /ingest proxy)
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Environment tag: 'development' or 'production' (inlined at build time)
NEXT_PUBLIC_PASSIE_ENV=development

# Ingestion cooldown in seconds for local development
PASSIE_INGEST_COOLDOWN_SECONDS=300

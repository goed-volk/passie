{
  "$schema": "https://app.kilo.ai/config.json",
  "indexing": {
    "enabled": true
  },
  "instructions": [
    "AGENTS.md",
    "docs/reference/README.md",
    "docs/architecture.md"
  ],
  "permission": {
    "edit": {
      ".kilo/**": "ask",
      "drizzle/**": "ask",
      "src/domain/**": "ask",
      "*": "allow"
    },
    "bash": {
      "pnpm test*": "allow",
      "pnpm lint*": "allow",
      "pnpm typecheck*": "allow",
      "pnpm build": "allow",
      "wrangler d1 * --remote*": "ask",
      "pnpm deploy*": "ask",
      "git push*": "ask",
      "git commit*": "ask",
      "git log": "allow",
      "git add": "allow",
      "git diff": "allow",
      "git status": "allow",
      "*": "ask"
    }
  },
  "mcp": {
    "better-auth": {
      "type": "remote",
      "url": "https://mcp.better-auth.com/mcp",
      "enabled": true
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    }
  }
}

{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/reference/README.md",
    "docs/architecture.md"
  ],
  "permission": {
    "edit": {
      ".kilo/**": "ask",
      "drizzle/**": "ask",
      "src/domain/**": "ask",
      "*": "allow"
    },
    "bash": {
      "pnpm test*": "allow",
      "pnpm lint*": "allow",
      "pnpm typecheck*": "allow",
      "wrangler d1 * --remote*": "ask",
      "pnpm deploy*": "ask",
      "git push*": "ask",
      "git commit*": "ask",
      "*": "ask"
    }
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "passie",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "passie.goedvolk.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "passie",
      "database_id": "xxxx-local-placeholder",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  }
}

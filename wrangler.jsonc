{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "passie",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "POSTHOG_HOST": "https://eu.i.posthog.com",
    "PASSIE_ENV": "production",
    "PASSIE_PUBLIC_ORIGIN": "https://passie.goedvolk.org",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://passie.goedvolk.org"
  },
  "routes": [
    {
      "pattern": "passie.goedvolk.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "passie",
      "database_id": "176bd801-9d6f-4d7e-8306-83ea0a0be157",
      "migrations_dir": "drizzle"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "inloggen@passie.goedvolk.org",
        "noreply@passie.goedvolk.org"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  },
  "env": {
    "staging": {
      "name": "passie-staging",
      "vars": {
        "POSTHOG_HOST": "https://eu.i.posthog.com",
        "PASSIE_ENV": "staging",
        "PASSIE_PUBLIC_ORIGIN": "https://passie-dev.goedvolk.org",
        "BETTER_AUTH_TRUSTED_ORIGINS": "https://passie-dev.goedvolk.org"
      },
      "routes": [
        {
          "pattern": "passie-dev.goedvolk.org",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "passie-staging-db",
          "database_id": "1c936aac-181c-47dc-98c2-6f6d64416595",
          "migrations_dir": "drizzle"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": [
            "inloggen@passie.goedvolk.org",
            "noreply@passie.goedvolk.org"
          ]
        }
      ]
    }
  }
}
